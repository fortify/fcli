apply from: "${sharedGradleScriptsDir}/fcli-module.gradle"

// Replace previous explicit task definition with reusable helper
registerActionZipTask(
    name: 'zipResources_actions',
    src: 'src/main/resources/com/fortify/cli/generic_action/actions/zip',
    dest: 'com/fortify/cli/generic_action'
)

// Build-time action to generate CI env vars output (ensure Groovy 'def')
def buildTimeAction_ci_envvars = tasks.register('buildTimeAction_ci_envvars', JavaExec) {
    group = 'build resources'
    description = 'Generate build-time CI environment variables action output'
    def outputDirProvider = layout.buildDirectory.dir("generated-action-output-resources")
    def inputYaml = file("${projectDir}/src/main/resources/com/fortify/cli/generic_action/actions/build-time/ci-envvars.yaml")
    inputs.file(inputYaml)
    inputs.property('projectVersion', project.version)
    outputs.dir(outputDirProvider)
    doFirst { outputDirProvider.get().asFile.mkdirs() }
    // Use dependency classpath excluding this project's own (yet-to-be-built) output to avoid circular dependency
    classpath = configurations.runtimeClasspath - sourceSets.main.output
    mainClass.set('com.fortify.cli.common.action.cli.cmd.RunBuildTimeFcliAction')
    args = ["${buildDir}/ci-envvars.log", inputYaml.absolutePath, '-d', outputDirProvider.get().asFile.absolutePath]
}