<configuration>
  <appender name="default" class="com.fortify.cli.common.progress.helper.ProgressAwareConsoleAppender">
    <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
      <level>WARN</level>
    </filter>
    <encoder>
        <charset>UTF-8</charset>
        <pattern>%msg%n%ex{0}</pattern>
    </encoder>
  </appender>

  <root level="warn">
    <appender-ref ref="default" />
  </root>
  
  <!-- Don't log warnings about incorrect cookie contents, commonly seen when downloading files from GitHub for example -->
  <logger name="org.apache.http.client.protocol.ResponseProcessCookies" level="ERROR"/>
</configuration>
