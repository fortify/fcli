  <Snippet id="67120AFE547FD4F3134DCE09FCC37D3C#src/main/java/com/microfocus/example/web/controllers/admin/AdminOrderController.java:100:117">
    <File>src/main/java/com/microfocus/example/web/controllers/admin/AdminOrderController.java</File>
