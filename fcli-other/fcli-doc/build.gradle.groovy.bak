apply plugin: 'java'
apply plugin: 'org.asciidoctor.jvm.convert'

apply from: "${sharedGradleScriptsDir}/fcli-java.gradle"

dependencies {
    implementation project("${fcliCommonRef}")
	implementation project("${fcliAppRef}")
	runtimeOnly 'info.picocli:picocli-codegen'
    implementation 'com.github.victools:jsonschema-generator:4.38.0'
    implementation 'com.github.victools:jsonschema-module-jackson:4.38.0'
}

// Refactored tasks to configuration avoidance with inputs/outputs
ext {
    docsSrcDir                = "${projectDir}/src/docs"
    staticAsciiDocSrcDir      = "${docsSrcDir}/asciidoc/static"
    versionedAsciiDocSrcDir   = "${docsSrcDir}/asciidoc/versioned"
    asciiDocTemplatesSrcDir   = "${docsSrcDir}/asciidoc/templates"
    docsOutDir                = "${buildDir}/generated-docs"
    asciiDocOutDir            = "${docsOutDir}/asciidoc"
    asciiDocManPageOutDir     = "${asciiDocOutDir}/manpage"
    manpageOutDir             = "${docsOutDir}/manpage/output"
    htmlOutDir                = "${docsOutDir}/html"
    ghPagesOutDir             = "${docsOutDir}/gh-pages"
    ghPagesVersionedOutDir    = "${ghPagesOutDir}/versioned"
    ghPagesStaticOutDir       = "${ghPagesOutDir}/static"
    actionSchemaOutDir        = "${ghPagesStaticOutDir}/schemas/action"
}

// Prepare directories
tasks.register('prepare') {
    group = 'documentation'
    description = 'Create documentation output directories'
    dependsOn('build')
    outputs.dirs(asciiDocOutDir, asciiDocManPageOutDir, manpageOutDir, htmlOutDir, ghPagesOutDir, actionSchemaOutDir)
    doLast {
        [docsOutDir, asciiDocOutDir, asciiDocManPageOutDir, manpageOutDir, htmlOutDir, ghPagesOutDir, actionSchemaOutDir].each { mkdir it }
    }
}

// Action schema generation
tasks.register('generateActionSchema', JavaExec) {
    group = 'documentation'
    description = 'Generate fcli action JSON schema'
    dependsOn('prepare')
    inputs.property('projectVersion', project.version)
    inputs.property('schemaVersion', fcliActionSchemaVersion)
    outputs.dir(actionSchemaOutDir)
    classpath(sourceSets.main.runtimeClasspath, configurations.runtimeClasspath)
    mainClass.set('com.fortify.cli.common.action.schema.generator.GenerateActionSchema')
    args project.version.startsWith("0."), fcliActionSchemaVersion, actionSchemaOutDir
}

// Man page resources -> generateAsciiDocManPage
tasks.register('generateAsciiDocManPage', JavaExec) {
    group = 'documentation'
    description = 'Generate intermediate AsciiDoc man pages'
    dependsOn('prepare')
    inputs.property('rootCommandsClassName', fcliRootCommandsClassName)
    outputs.dir(asciiDocManPageOutDir)
    def capture = new ByteArrayOutputStream()
    standardOutput = capture
    classpath(configurations.runtimeClasspath, configurations.annotationProcessor)
    mainClass.set('com.fortify.cli.app.runner.util.FortifyCLIResourceBundlePropertiesHelper')
    doLast {
        def docProperties = capture.toString().split('\n').findAll { it.contains(':') }.collectEntries { e-> def p=e.split(':',2); [(p[0]):p[1]] }
        javaexec {
            classpath(configurations.runtimeClasspath, configurations.annotationProcessor)
            systemProperties = docProperties
            mainClass.set('picocli.codegen.docgen.manpage.ManPageGenerator')
            args fcliRootCommandsClassName, "--outdir=${asciiDocManPageOutDir}", '-v'
        }
    }
}

['generateAsciiDocGenericActions':'Generate Generic Action AsciiDoc',
 'generateAsciiDocSSCActions':'Generate SSC Action AsciiDoc',
 'generateAsciiDocFoDActions':'Generate FoD Action AsciiDoc',
 'generateAsciiDocActionDevelopment':'Generate Action Development AsciiDoc']
    .each { n, desc ->
        tasks.register(n, JavaExec) {
            group = 'documentation'
            description = desc
            dependsOn('generateAsciiDocManPage')
            outputs.dir(asciiDocOutDir)
            classpath(configurations.runtimeClasspath, configurations.annotationProcessor)
            mainClass.set('com.fortify.cli.app.FortifyCLI')
            if (n=='generateAsciiDocGenericActions') {
                args 'action','asciidoc', "-d=${asciiDocManPageOutDir}", "-f=${asciiDocOutDir}/generic-actions.adoc"
            } else if (n=='generateAsciiDocSSCActions') {
                args 'ssc','action','asciidoc', "-d=${asciiDocManPageOutDir}", "-f=${asciiDocOutDir}/ssc-actions.adoc"
            } else if (n=='generateAsciiDocFoDActions') {
                args 'fod','action','asciidoc', "-d=${asciiDocManPageOutDir}", "-f=${asciiDocOutDir}/fod-actions.adoc"
            } else if (n=='generateAsciiDocActionDevelopment') {
                // Keep behavior from original task
                args 'action','run','--on-unsigned=ignore','--on-invalid-version=ignore', "${projectDir}/src/actions/generate-action-dev-doc.yaml", "--file=${asciiDocOutDir}/action-development.adoc"
            }
        }
    }

// Aggregate copy of versioned asciidoc sources
tasks.register('generateAsciiDocAll', Copy) {
    group = 'documentation'
    description = 'Aggregate all generated AsciiDoc files'
    dependsOn('generateAsciiDocActionDevelopment','generateAsciiDocGenericActions','generateAsciiDocSSCActions','generateAsciiDocFoDActions')
    from(versionedAsciiDocSrcDir) { include '*.adoc' }
    into(asciiDocOutDir)
    inputs.dir(versionedAsciiDocSrcDir)
    outputs.dir(asciiDocOutDir)
}

// Asciidoctor tasks (HTML, Manpage, Jekyll)
[ 'generateManpageOutput':['generateAsciiDocAll', manpageOutDir, 'manpage'],
  'asciiDoctorVersionedHtml':['generateAsciiDocAll', htmlOutDir, 'html5'],
  'asciiDoctorVersionedJekyll':['generateAsciiDocAll', ghPagesVersionedOutDir, 'html5'],
  'asciiDoctorStaticJekyll':['generateActionSchema', ghPagesStaticOutDir, 'html5']
].each { name, cfg ->
    tasks.register(name, org.asciidoctor.gradle.jvm.AsciidoctorTask) {
        group = 'documentation'
        description = "Generate ${name} output"
        dependsOn(cfg[0])
        sourceDir = file(name=='asciiDoctorStaticJekyll'? staticAsciiDocSrcDir : (name=='generateManpageOutput'? asciiDocManPageOutDir : asciiDocOutDir))
        outputDir = file(cfg[1])
        outputs.dir(outputDir)
        forkOptions { jvmArgs('--add-opens','java.base/sun.nio.ch=ALL-UNNAMED','--add-opens','java.base/java.io=ALL-UNNAMED') }
        outputOptions { backends = [cfg[2]] }
        if (name=='asciiDoctorVersionedHtml' || name=='asciiDoctorVersionedJekyll') {
            attributes = [ 'toc':'left','sectanchors':'true','docinfo':'shared','jekyll': name=='asciiDoctorVersionedJekyll', 'bannertitle':'FCLI: The Universal Fortify CLI','docversion':"${project.version}",'actionSchemaVersion':"${fcliActionSchemaVersion}",'actionSchemaUrl':"${fcliActionSchemaUrl}" ]
            options = [ 'template_dirs':[new File("${asciiDocTemplatesSrcDir}").absolutePath] ]
        } else if (name=='asciiDoctorStaticJekyll') {
            attributes = [ 'toc':'left','sectanchors':'true','docinfo':'shared','jekyll':true,'stylesheet':false,'bannertitle':'FCLI: The Universal Fortify CLI','docversion':'[select]','revnumber':'none' ]
            options = [ 'template_dirs':[new File("${asciiDocTemplatesSrcDir}").absolutePath] ]
        }
    }
}

// Distribution zips
[ 'distDocsVersionedHtml':['asciiDoctorVersionedHtml','docs-html.zip', { htmlOutDir }],
  'distDocsManpage':['generateManpageOutput','docs-manpage.zip', { manpageOutDir }],
  'distDocsVersionedJekyll':['asciiDoctorVersionedJekyll','docs-gh-pages-versioned.zip', { ghPagesVersionedOutDir }],
  'distDocsStaticJekyll':['asciiDoctorStaticJekyll','docs-gh-pages-static.zip', { ghPagesStaticOutDir }]
].each { name, c ->
    tasks.register(name, Zip) {
        group = 'distribution'
        description = "Package ${name} output"
        dependsOn(c[0])
        archiveFileName = c[1]
        destinationDirectory = file(releaseAssetsDir ?: distDir)
        from(layout.buildDirectory.dir(c[2]()))
        outputs.file(layout.buildDirectory.file("${(releaseAssetsDir ?: distDir)}/${c[1]}"))
    }
}

// Aggregate dist
tasks.register('dist') {
    group = 'distribution'
    description = 'Build all documentation distribution archives'
    dependsOn('distDocsVersionedHtml','distDocsManpage','distDocsVersionedJekyll','distDocsStaticJekyll')
}