apply plugin: 'java'

dependencies {
	runtimeOnly project("${fcliAppRef}")
	//runtimeOnly 'info.picocli:picocli-codegen'
}

// Refactored tasks
 def autoCompleteOutput = layout.buildDirectory.file("dist/fcli_completion")

tasks.register('distAutoComplete', JavaExec) {
    group = 'distribution'
    description = 'Generate fcli autocomplete script'
    dependsOn('createDistDir')
    inputs.property('rootCommandsClassName', fcliRootCommandsClassName)
    inputs.files(configurations.runtimeClasspath, configurations.annotationProcessor)
    outputs.file(autoCompleteOutput)
    classpath(configurations.runtimeClasspath, configurations.annotationProcessor)
    mainClass.set('picocli.AutoComplete')
    args fcliRootCommandsClassName, '-f', "--completionScript=${autoCompleteOutput.get().asFile.absolutePath}"
}

tasks.register('dist') {
    group = 'distribution'
    description = 'Generate autocomplete distribution artifacts'
    dependsOn('distAutoComplete')
    outputs.file(autoCompleteOutput)
}